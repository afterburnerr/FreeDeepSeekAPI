# ---- DeepSeek auth -------------------------------------------------------
# Fallback token. If a client omits Authorization: Bearer, this one is used.
# Leave empty if you want to force every client to send its own token.
#
# How to get it:
#   1. Open https://chat.deepseek.com and log in
#   2. DevTools (F12) -> Console
#   3. Run:   JSON.parse(localStorage.getItem("userToken")).value
DEEPSEEK_AUTH_TOKEN=

# Enable DeepSeek's built-in web search by default when the client did not
# supply `search_enabled`.  true/1/yes/on -> enabled.
DEEPSEEK_SEARCH_DEFAULT=false

# How many completions to serve out of one upstream chat session before
# rotating to a fresh one. Keeps server-side context clean for high-volume
# classifier use cases.
DEEPSEEK_SESSION_REUSE_LIMIT=30

# Cap on how many distinct per-token DeepSeekAPI clients we keep cached.
DEEPSEEK_CLIENT_CACHE_LIMIT=16


# ---- Admin endpoints -----------------------------------------------------
# Bearer secret required by /admin/refresh-cookies and /admin/health.
# If left empty, the DEEPSEEK_AUTH_TOKEN above is used as the admin secret
# so a single-user setup needs zero extra config.
ADMIN_SECRET=

# Hard timeout (seconds) on the cookie-refresh subprocess.
ADMIN_REFRESH_TIMEOUT=180


# ---- Server --------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
